<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = BackOfficeShellViewModel. Menu left, current page right (DataTemplates in MainWindow). -->
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="180" Background="#F2F4F7" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding WelcomeText}" TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,6" />
                    <Button AutomationProperties.AutomationId="Logout" Content="{x:Static res:Strings.Menu_Logout}"
                            Command="{Binding LogoutCommand}" Padding="6,3" />
                </StackPanel>
                <StackPanel>
                    <Button AutomationProperties.AutomationId="MenuLineDashboard" Content="{x:Static res:Strings.Menu_LineDashboard}"
                            Command="{Binding ShowLineDashboardCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Button AutomationProperties.AutomationId="MenuWorkOrders" Content="{x:Static res:Strings.Menu_WorkOrders}"
                            Command="{Binding ShowWorkOrdersCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Button AutomationProperties.AutomationId="MenuReports" Content="{x:Static res:Strings.Menu_Reports}"
                            Command="{Binding ShowReportsCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Separator Margin="0,6" />
                    <Button AutomationProperties.AutomationId="MenuItems" Content="{x:Static res:Strings.Menu_Items}"
                            Command="{Binding ShowItemsCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Button AutomationProperties.AutomationId="MenuBoms" Content="{x:Static res:Strings.Menu_Boms}"
                            Command="{Binding ShowBomsCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Button AutomationProperties.AutomationId="MenuRoutings" Content="{x:Static res:Strings.Menu_Routings}"
                            Command="{Binding ShowRoutingsCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Separator Margin="0,6" />
                    <Button AutomationProperties.AutomationId="MenuWorkCenters" Content="{x:Static res:Strings.Menu_WorkCenters}"
                            Command="{Binding ShowWorkCentersCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Button AutomationProperties.AutomationId="MenuMachines" Content="{x:Static res:Strings.Menu_Machines}"
                            Command="{Binding ShowMachinesCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Button AutomationProperties.AutomationId="MenuShifts" Content="{x:Static res:Strings.Menu_Shifts}"
                            Command="{Binding ShowShiftsCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Button AutomationProperties.AutomationId="MenuPlantCalendar" Content="{x:Static res:Strings.Menu_PlantCalendar}"
                            Command="{Binding ShowPlantCalendarCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Button AutomationProperties.AutomationId="MenuDefectCodes" Content="{x:Static res:Strings.Menu_DefectCodes}"
                            Command="{Binding ShowDefectCodesCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Button AutomationProperties.AutomationId="MenuDowntimeReasons" Content="{x:Static res:Strings.Menu_DowntimeReasons}"
                            Command="{Binding ShowDowntimeReasonsCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                    <Separator Margin="0,6" />
                    <Button AutomationProperties.AutomationId="MenuImport" Content="{x:Static res:Strings.Menu_Import}"
                            Command="{Binding ShowImportCommand}" Padding="6,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Content="{Binding Pages.CurrentPage}" Margin="16" />
    </DockPanel>
</UserControl>
