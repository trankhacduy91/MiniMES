<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.MasterData.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core"
             xmlns:md="clr-namespace:MiniMes.Client.Core.ViewModels.MasterData;assembly=MiniMes.Client.Core">
    <!-- DataContext = any CatalogViewModel (work centers, machines, shifts, calendar, defect codes, downtime reasons).
         Grid columns come from the ViewModel's Columns (built in code-behind); the form from its Fields. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                   Style="{StaticResource CollapsedWhenEmpty}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button AutomationProperties.AutomationId="New" Content="{x:Static res:Strings.Common_New}"
                    Command="{Binding NewCommand}" Style="{StaticResource ToolButton}" />
            <Button AutomationProperties.AutomationId="Edit" Content="{x:Static res:Strings.Common_Edit}"
                    Command="{Binding EditCommand}" Style="{StaticResource ToolButton}" />
            <Button AutomationProperties.AutomationId="Remove" Content="{Binding RemoveLabel}"
                    Command="{Binding RemoveCommand}" Style="{StaticResource ToolButton}" />
            <Button AutomationProperties.AutomationId="Refresh" Content="{x:Static res:Strings.Common_Refresh}"
                    Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="Error" Text="{Binding ErrorMessage}"
                   Style="{StaticResource PageError}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="RowsGrid" AutomationProperties.AutomationId="Rows" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                </DataGrid.InputBindings>
            </DataGrid>

            <!-- Edit form, shown while editing -->
            <Border Grid.Column="1" Width="340" Margin="16,0,0,0" Padding="12" BorderBrush="#D0D5DD" BorderThickness="1"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" FontSize="16" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type md:CatalogField}">
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                                        <TextBox AutomationProperties.AutomationId="{Binding Key}" Padding="3"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Text">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                            <Setter Property="Background" Value="#F2F4F7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <CheckBox AutomationProperties.AutomationId="{Binding Key}" IsChecked="{Binding Flag}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Bool">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <ComboBox AutomationProperties.AutomationId="{Binding Key}" ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding Text}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Choice">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource FieldHint}" />
                                        <TextBlock AutomationProperties.Name="{Binding Error}" Text="{Binding Error}" Style="{StaticResource FieldError}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button AutomationProperties.AutomationId="Save" Content="{x:Static res:Strings.Common_Save}"
                                    Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource ToolButton}" />
                            <Button AutomationProperties.AutomationId="Cancel" Content="{x:Static res:Strings.Common_Cancel}"
                                    Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
