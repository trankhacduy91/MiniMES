<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.MasterData.RoutingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = RoutingEditorViewModel. Left: versions. Right: steps of the selected version. -->
    <UserControl.Resources>
        <DataTemplate x:Key="ItemOption">
            <TextBlock>
                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" - " /><Run Text="{Binding Name, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Routing_Title}" Style="{StaticResource PageTitle}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{x:Static res:Strings.Bom_Item}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox AutomationProperties.AutomationId="Parent" Width="360" ItemsSource="{Binding Parents}"
                      SelectedItem="{Binding SelectedParent}" ItemTemplate="{StaticResource ItemOption}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock AutomationProperties.AutomationId="Info" Text="{Binding InfoMessage}" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock AutomationProperties.AutomationId="Error" Text="{Binding ErrorMessage}" Style="{StaticResource PageError}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Bom_Versions}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button AutomationProperties.AutomationId="NewVersion" Content="{x:Static res:Strings.Bom_NewVersion}"
                            Command="{Binding NewVersionCommand}" Style="{StaticResource ToolButton}" />
                    <Button AutomationProperties.AutomationId="Approve" Content="{x:Static res:Strings.Bom_Approve}"
                            Command="{Binding ApproveCommand}" Style="{StaticResource ToolButton}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="VersionStatus" Text="{Binding StatusText}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
                <DataGrid AutomationProperties.AutomationId="Versions" ItemsSource="{Binding Versions}"
                          SelectedItem="{Binding SelectedVersion}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.Bom_Version}" Binding="{Binding Version}" Width="45" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Bom_Status}" Binding="{Binding Status}" Width="70" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Bom_EffectiveFrom}" Binding="{Binding EffectiveFrom, StringFormat=yyyy-MM-dd}" Width="80" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Routing_StepCount}" Binding="{Binding StepCount}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button AutomationProperties.AutomationId="AddStep" Content="{x:Static res:Strings.Routing_AddStep}"
                            Command="{Binding AddStepCommand}" Style="{StaticResource ToolButton}" />
                    <Button AutomationProperties.AutomationId="RemoveStep" Content="{x:Static res:Strings.Routing_RemoveStep}"
                            Command="{Binding RemoveStepCommand}" Style="{StaticResource ToolButton}" />
                    <Button AutomationProperties.AutomationId="MoveUp" Content="{x:Static res:Strings.Routing_MoveUp}"
                            Command="{Binding MoveUpCommand}" Style="{StaticResource ToolButton}" MinWidth="50" />
                    <Button AutomationProperties.AutomationId="MoveDown" Content="{x:Static res:Strings.Routing_MoveDown}"
                            Command="{Binding MoveDownCommand}" Style="{StaticResource ToolButton}" MinWidth="50" />
                    <Button AutomationProperties.AutomationId="SaveSteps" Content="{x:Static res:Strings.Routing_SaveSteps}"
                            Command="{Binding SaveStepsCommand}" Style="{StaticResource ToolButton}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Routing_Hint}" Foreground="Gray" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Bom_LockedHint}" Foreground="Gray" Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedVersion.Status}" Value="Approved">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DataGrid AutomationProperties.AutomationId="Steps" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          HeadersVisibility="Column" IsReadOnly="{Binding IsDraft, Converter={StaticResource Not}}">
                    <DataGrid.Columns>
                        <!-- Seq is set by the order of the rows (Up/Down), not typed. -->
                        <DataGridTextColumn Header="{x:Static res:Strings.Routing_Seq}" Binding="{Binding Seq}" IsReadOnly="True" Width="45" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Routing_Operation}" Binding="{Binding OperationCode}" Width="80" />
                        <DataGridTemplateColumn Header="{x:Static res:Strings.Routing_WorkCenter}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.WorkCenters, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValuePath="Id" DisplayMemberPath="Code"
                                              SelectedValue="{Binding WorkCenterId, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static res:Strings.Routing_CycleTime}" Binding="{Binding IdealCycleTimeSec, StringFormat={}{0:0.###}}" Width="100" />
                        <DataGridCheckBoxColumn Header="{x:Static res:Strings.Routing_Inspection}" Binding="{Binding IsInspection, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                        <DataGridCheckBoxColumn Header="{x:Static res:Strings.Routing_Mandatory}" Binding="{Binding IsMandatory, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                        <!-- [v2] work instruction opened from the kiosk (M3) -->
                        <DataGridTextColumn Header="{x:Static res:Strings.Routing_SopUrl}" Binding="{Binding SopUrl}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
