<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.MasterData.ItemEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = ItemEditViewModel. Red border = client rule (INotifyDataErrorInfo); the text under each box
         comes from FieldErrors, which also holds the server's 400/409 answer for that field. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="420" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />

            <TextBlock Text="{x:Static res:Strings.Item_Code}" Style="{StaticResource FieldLabel}" />
            <TextBox AutomationProperties.AutomationId="Code" Padding="3" CharacterCasing="Upper"
                     Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsNew, Converter={StaticResource Not}}" />
            <TextBlock AutomationProperties.AutomationId="CodeError" Text="{Binding FieldErrors[Code]}" Style="{StaticResource FieldError}" />

            <TextBlock Text="{x:Static res:Strings.Item_Name}" Style="{StaticResource FieldLabel}" />
            <TextBox AutomationProperties.AutomationId="Name" Padding="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock AutomationProperties.AutomationId="NameError" Text="{Binding FieldErrors[Name]}" Style="{StaticResource FieldError}" />

            <TextBlock Text="{x:Static res:Strings.Item_Type}" Style="{StaticResource FieldLabel}" />
            <ComboBox AutomationProperties.AutomationId="Type" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type}"
                      IsEnabled="{Binding IsNew}" />
            <TextBlock Text="{Binding FieldErrors[Type]}" Style="{StaticResource FieldError}" />

            <TextBlock Text="{x:Static res:Strings.Item_Uom}" Style="{StaticResource FieldLabel}" />
            <ComboBox AutomationProperties.AutomationId="Uom" ItemsSource="{Binding UomOptions}" SelectedItem="{Binding Uom}"
                      IsEnabled="{Binding IsNew}" />
            <TextBlock Text="{Binding FieldErrors[Uom]}" Style="{StaticResource FieldError}" />

            <CheckBox AutomationProperties.AutomationId="IsSerialized" Content="{x:Static res:Strings.Item_IsSerialized}"
                      IsChecked="{Binding IsSerialized}" IsEnabled="{Binding IsNew}" Margin="0,10,0,0" />
            <TextBlock Text="{Binding FieldErrors[IsSerialized]}" Style="{StaticResource FieldError}" />
            <CheckBox AutomationProperties.AutomationId="IsLotControlled" Content="{x:Static res:Strings.Item_IsLotControlled}"
                      IsChecked="{Binding IsLotControlled}" IsEnabled="{Binding IsNew}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding FieldErrors[IsLotControlled]}" Style="{StaticResource FieldError}" />
            <CheckBox AutomationProperties.AutomationId="SkipIqc" Content="{x:Static res:Strings.Item_SkipIqc}"
                      IsChecked="{Binding SkipIqc}" IsEnabled="{Binding CanEditSkipIqc}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding FieldErrors[SkipIqc]}" Style="{StaticResource FieldError}" />

            <TextBlock Text="{x:Static res:Strings.ItemEdit_TraceabilityHint}" TextWrapping="Wrap" Foreground="Gray"
                       FontSize="11" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button AutomationProperties.AutomationId="Save" Content="{x:Static res:Strings.Common_Save}"
                        Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource ToolButton}" />
                <Button AutomationProperties.AutomationId="Cancel" Content="{x:Static res:Strings.Common_Cancel}"
                        Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource ToolButton}" />
            </StackPanel>
            <TextBlock AutomationProperties.AutomationId="Error" Text="{Binding ErrorMessage}" Style="{StaticResource PageError}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
