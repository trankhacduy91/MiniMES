<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.Quality.FaiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = FaiViewModel (spec M7 step 8b). Queue of WOs whose first article waits for QC on the left, the
         worksheet on the right: automatic checks (green/red with the reason), manual ones to tick, Pass / Fail, history. -->
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="FaiRefresh" Content="{x:Static res:Strings.Fai_Refresh}"
                    Command="{Binding RefreshCommand}" Padding="10,3" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.Fai_Title}" FontSize="20" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageError}" Text="{Binding ErrorMessage}" AutomationProperties.AutomationId="FaiError" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CollapsedWhenEmpty}" Text="{Binding InfoMessage}"
                   AutomationProperties.AutomationId="FaiInfo" Foreground="#FF2E7D32" Margin="0,0,0,6" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" AutomationProperties.AutomationId="FaiQueue" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" Margin="0,0,12,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="WO" Binding="{Binding WoNo}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Fai_Item}" Binding="{Binding ItemCode}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Fai_Line}" Binding="{Binding Line}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Fai_SampleColumn}" Binding="{Binding SampleSerialNo}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Fai_SampleStatus}" Binding="{Binding SampleStatus}" />
                    <DataGridCheckBoxColumn Header="{x:Static res:Strings.Fai_Ready}" Binding="{Binding SampleReady, Mode=OneWay}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSheet, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock AutomationProperties.AutomationId="FaiSheetTitle" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock AutomationProperties.AutomationId="FaiSample" Text="{Binding SampleText}" Margin="0,4,0,0" />
                    <TextBlock AutomationProperties.AutomationId="FaiStatus" Foreground="Gray" Margin="0,2,0,0">
                        <Run Text="{x:Static res:Strings.Fai_Status}" /> <Run Text="{Binding Sheet.FaiStatus, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="{x:Static res:Strings.Fai_Checklist}" Style="{StaticResource Label}" />
                    <ItemsControl AutomationProperties.AutomationId="FaiItems" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Auto: green / red badge, not clickable. Manual: a checkbox QC ticks. -->
                                        <Border Grid.Column="0" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFC0392B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                                            <Setter Property="Background" Value="#FF2E7D32" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                        <CheckBox Grid.Column="0" AutomationProperties.AutomationId="{Binding Code, StringFormat=FaiCheck_{0}}"
                                                  IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="4,2,0,0"
                                                  IsEnabled="{Binding DataContext.CanFail, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Text, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CollapsedWhenEmpty}" Foreground="#FFC0392B"
                                                       TextWrapping="Wrap" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Static res:Strings.Fai_Note}" Style="{StaticResource Label}" />
                    <TextBox AutomationProperties.AutomationId="FaiNote" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="48" IsEnabled="{Binding CanFail}" />
                    <TextBlock Text="{x:Static res:Strings.Fai_DefectOnFail}" Style="{StaticResource Label}" />
                    <ComboBox AutomationProperties.AutomationId="FaiDefect" ItemsSource="{Binding DefectCodes}" SelectedItem="{Binding DefectCode}"
                              Width="200" HorizontalAlignment="Left" IsEnabled="{Binding CanFail}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button AutomationProperties.AutomationId="FaiPass" Content="{x:Static res:Strings.Fai_Pass}"
                                Command="{Binding PassCommand}" Style="{StaticResource Action}" />
                        <Button AutomationProperties.AutomationId="FaiFail" Content="{x:Static res:Strings.Fai_Fail}"
                                Command="{Binding FailCommand}" Style="{StaticResource Action}" />
                    </WrapPanel>
                    <TextBlock AutomationProperties.AutomationId="FaiHint" Style="{StaticResource CollapsedWhenEmpty}" Text="{Binding PassHint}"
                               Foreground="#FFC0392B" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Text="{x:Static res:Strings.Fai_History}" Style="{StaticResource Label}" Margin="0,14,0,2" />
                    <DataGrid AutomationProperties.AutomationId="FaiHistory" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:Strings.Fai_When}" Binding="{Binding InspectedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Fai_SampleColumn}" Binding="{Binding SerialNo}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Fai_Result}" Binding="{Binding Result}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Fai_By}" Binding="{Binding InspectedBy}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Fai_DefectOnFail}" Binding="{Binding DefectCode}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Fai_Note}" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
