<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.Quality.ControlChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = ControlChartViewModel (spec M7 step 7). Points, limits, violations and statistics come ready from
         the API; the two charts are PlotModels built in the ViewModel (OxyPlot.Core), PlotView only draws them. -->
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.Spc_Plan}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox AutomationProperties.AutomationId="SpcPlan" Width="200" Margin="0,0,12,0"
                          ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Code" />
                <TextBlock Text="{x:Static res:Strings.Spc_Points}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox AutomationProperties.AutomationId="SpcTake" Width="70" Margin="0,0,12,0"
                          ItemsSource="{Binding Takes}" SelectedItem="{Binding SelectedTake}" />
                <Button AutomationProperties.AutomationId="SpcRefresh" Content="{x:Static res:Strings.Spc_Refresh}"
                        Command="{Binding RefreshCommand}" Padding="10,2" />
            </WrapPanel>
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Spc_Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SourceText}" Foreground="Gray" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="#FFFFA000" Padding="10,6" Margin="0,0,0,8" CornerRadius="3"
                Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Static res:Strings.Dashboard_Reconnecting}" FontWeight="SemiBold" />
        </Border>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageError}" Text="{Binding ErrorMessage}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CollapsedWhenEmpty}" Text="{Binding NoticeText}"
                   AutomationProperties.AutomationId="SpcNotice" Foreground="#FFC0392B" FontWeight="SemiBold" Margin="0,0,0,6" />

        <!-- Right: what the numbers say, then the open alerts. -->
        <DockPanel DockPanel.Dock="Right" Width="300" Margin="12,0,0,0">
            <Border DockPanel.Dock="Top" BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock AutomationProperties.AutomationId="SpcCapability" Text="{Binding CapabilityText}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding WindowText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock AutomationProperties.AutomationId="SpcBaseline" Text="{Binding BaselineText}" Margin="0,8,0,0"
                               Foreground="Gray" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static res:Strings.Spc_Legend}" Margin="0,8,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Spc_OpenAlerts}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ListView AutomationProperties.AutomationId="SpcAlerts" ItemsSource="{Binding Alerts}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock>
                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="Gray" />
                                <Run Text="{Binding Rule, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FFC0392B" />
                            </TextBlock>
                            <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <!-- I chart on top, [v2] MR chart under it, same X (sample number). -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="220" />
                <RowDefinition Height="*" MinHeight="140" />
            </Grid.RowDefinitions>
            <oxy:PlotView Grid.Row="0" AutomationProperties.AutomationId="SpcIChart"
                          Model="{Binding IChart}" Controller="{Binding IChartController}" />
            <oxy:PlotView Grid.Row="1" AutomationProperties.AutomationId="SpcMrChart" Margin="0,6,0,0"
                          Model="{Binding MrChart}" Controller="{Binding MrChartController}" />
        </Grid>
    </DockPanel>
</UserControl>
