<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.Quality.NcrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = NcrViewModel (spec M7 step 8). List left, the selected NCR (or the new-NCR form) right. Buttons are
         enabled by status and role; the API checks both again (403 / 409 / 422 shown in the error line). -->
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.Ncr_StatusFilter}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox AutomationProperties.AutomationId="NcrStatusFilter" Width="130" Margin="0,0,8,0"
                          ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" />
                <Button AutomationProperties.AutomationId="NcrRefresh" Content="{x:Static res:Strings.Ncr_Refresh}"
                        Command="{Binding RefreshCommand}" Style="{StaticResource Action}" />
                <Button AutomationProperties.AutomationId="NcrNew" Content="{x:Static res:Strings.Ncr_New}"
                        Command="{Binding NewFormCommand}" Style="{StaticResource Action}" Margin="0" />
            </WrapPanel>
            <TextBlock Text="{x:Static res:Strings.Ncr_Title}" FontSize="20" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageError}" Text="{Binding ErrorMessage}" AutomationProperties.AutomationId="NcrError" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CollapsedWhenEmpty}" Text="{Binding InfoMessage}"
                   AutomationProperties.AutomationId="NcrInfo" Foreground="#FF2E7D32" Margin="0,0,0,6" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" AutomationProperties.AutomationId="NcrList" ItemsSource="{Binding Ncrs}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" Margin="0,0,12,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NCR" Binding="{Binding NcrNo}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Ncr_StatusFilter}" Binding="{Binding Status}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Ncr_Source}" Binding="{Binding Source}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Ncr_DefectCode}" Binding="{Binding DefectCode}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Ncr_Qty}" Binding="{Binding Qty}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Ncr_Disposition}" Binding="{Binding Disposition}" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Ncr_Description}" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- The new-NCR form -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Ncr_New}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_Source}" Style="{StaticResource Label}" />
                    <ComboBox AutomationProperties.AutomationId="NcrNewSource" ItemsSource="{Binding Sources}" SelectedItem="{Binding NewSource}" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_SourceRef}" Style="{StaticResource Label}" />
                    <TextBox AutomationProperties.AutomationId="NcrNewSourceRef" Text="{Binding NewSourceRef, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_DefectCode}" Style="{StaticResource Label}" />
                    <ComboBox AutomationProperties.AutomationId="NcrNewDefect" ItemsSource="{Binding DefectCodes}" SelectedItem="{Binding NewDefectCode}" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_Description}" Style="{StaticResource Label}" />
                    <TextBox AutomationProperties.AutomationId="NcrNewDescription" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="54" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_Qty}" Style="{StaticResource Label}" />
                    <TextBox AutomationProperties.AutomationId="NcrNewQty" Text="{Binding NewQty, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_Serials}" Style="{StaticResource Label}" />
                    <TextBox AutomationProperties.AutomationId="NcrNewSerials" Text="{Binding NewSerials, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_Lots}" Style="{StaticResource Label}" />
                    <TextBox AutomationProperties.AutomationId="NcrNewLots" Text="{Binding NewLots, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                    <Button AutomationProperties.AutomationId="NcrCreate" Content="{x:Static res:Strings.Ncr_Create}" Command="{Binding CreateCommand}"
                            Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- The selected NCR -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock AutomationProperties.AutomationId="NcrStatus" Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail.Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Margin="0,4,0,0" Foreground="Gray">
                        <Run Text="{Binding Detail.Source, Mode=OneWay}" /> <Run Text="{Binding Detail.SourceRef, Mode=OneWay}" /> ·
                        <Run Text="{Binding Detail.DefectCode, Mode=OneWay}" /> · Qty <Run Text="{Binding Detail.Qty, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Text="{x:Static res:Strings.Ncr_Targets}" Style="{StaticResource Label}" />
                    <ItemsControl AutomationProperties.AutomationId="NcrTargets" ItemsSource="{Binding Detail.Targets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas">
                                    <Run Text="{Binding Type, Mode=OneWay}" /> <Run Text="{Binding Code, Mode=OneWay}" /> (<Run Text="{Binding Status, Mode=OneWay}" />)
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Ncr_OpenedBy}" Foreground="Gray" Margin="0,0,10,0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.CreatedBy}" />
                        <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Ncr_ReviewedBy}" Foreground="Gray" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.ReviewedBy}" />
                        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Ncr_ProposedBy}" Foreground="Gray" />
                        <TextBlock Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="NcrProposedBy" Text="{Binding Detail.ProposedBy}" />
                        <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Ncr_ApprovedBy}" Foreground="Gray" />
                        <TextBlock Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="NcrApprovedBy" Text="{Binding Detail.ApprovedBy}" />
                        <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Ncr_ClosedBy}" Foreground="Gray" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail.ClosedBy}" />
                        <TextBlock Grid.Row="5" Text="{x:Static res:Strings.Ncr_ActiveHolds}" Foreground="Gray" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Detail.ActiveHolds}" />
                    </Grid>

                    <TextBlock Text="{x:Static res:Strings.Ncr_Review}" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <Button AutomationProperties.AutomationId="NcrStartReview" Content="{x:Static res:Strings.Ncr_StartReview}"
                            Command="{Binding StartReviewCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_Disposition}" Style="{StaticResource Label}" />
                    <ComboBox AutomationProperties.AutomationId="NcrDisposition" ItemsSource="{Binding Dispositions}" SelectedItem="{Binding ProposedDisposition}"
                              IsEnabled="{Binding CanPropose}" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_Note}" Style="{StaticResource Label}" />
                    <TextBox AutomationProperties.AutomationId="NcrNote" Text="{Binding DispositionNote, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="48" IsEnabled="{Binding CanPropose}" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_ConcessionRef}" Style="{StaticResource Label}" />
                    <TextBox AutomationProperties.AutomationId="NcrConcession" Text="{Binding ConcessionRef, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanPropose}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button AutomationProperties.AutomationId="NcrPropose" Content="{x:Static res:Strings.Ncr_Propose}"
                                Command="{Binding ProposeCommand}" Style="{StaticResource Action}" />
                        <Button AutomationProperties.AutomationId="NcrApprove" Content="{x:Static res:Strings.Ncr_Approve}"
                                Command="{Binding ApproveCommand}" Style="{StaticResource Action}" />
                        <Button AutomationProperties.AutomationId="NcrReject" Content="{x:Static res:Strings.Ncr_RejectProposal}"
                                Command="{Binding RejectProposalCommand}" Style="{StaticResource Action}" />
                    </WrapPanel>
                    <TextBlock AutomationProperties.AutomationId="NcrHint" Style="{StaticResource CollapsedWhenEmpty}" Text="{Binding ApproveHint}"
                               Foreground="#FFC0392B" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Static res:Strings.Ncr_CapaReference}" Style="{StaticResource Label}" />
                    <TextBox AutomationProperties.AutomationId="NcrCapa" Text="{Binding CapaReference, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button AutomationProperties.AutomationId="NcrClose" Content="{x:Static res:Strings.Ncr_Close}"
                                Command="{Binding CloseNcrCommand}" Style="{StaticResource Action}" />
                        <Button AutomationProperties.AutomationId="NcrCancel" Content="{x:Static res:Strings.Ncr_Cancel}"
                                Command="{Binding CancelNcrCommand}" Style="{StaticResource Action}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
