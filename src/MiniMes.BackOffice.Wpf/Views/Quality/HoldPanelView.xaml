<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.Quality.HoldPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
    <!-- DataContext = HoldPanelViewModel (spec M7 step 9). The Hold dialog as a panel over the host screen: target,
         preview (how many boards, which lots, shipped warning), reason, optional NCR, Hold. -->
    <Grid Background="#80000000">
        <Border Background="White" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Hold_Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

                <StackPanel Visibility="{Binding CanChooseScope, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static res:Strings.Hold_Scope}" Foreground="Gray" />
                    <ComboBox AutomationProperties.AutomationId="HoldScope" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}"
                              Width="200" HorizontalAlignment="Left" Margin="0,2,0,6" />
                </StackPanel>
                <TextBlock Text="{Binding ReferenceLabel}" Foreground="Gray" />
                <TextBox AutomationProperties.AutomationId="HoldReference" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" AcceptsReturn="{Binding IsSerialList}" Margin="0,2,0,6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSerialList}" Value="True">
                                    <Setter Property="Height" Value="80" />
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Grid Visibility="{Binding IsWindow, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Hold_From}" Foreground="Gray" />
                        <TextBox AutomationProperties.AutomationId="HoldFrom" Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static res:Strings.Hold_To}" Foreground="Gray" />
                        <TextBox AutomationProperties.AutomationId="HoldTo" Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <Button AutomationProperties.AutomationId="HoldPreview" Content="{x:Static res:Strings.Hold_Preview}" Command="{Binding PreviewCommand}"
                        HorizontalAlignment="Left" Padding="10,3" />

                <Border Background="#FFFFF8E1" Padding="8" Margin="0,8,0,0" CornerRadius="3"
                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock AutomationProperties.AutomationId="HoldPreviewText" Text="{Binding PreviewText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WarningText}" Style="{StaticResource CollapsedWhenEmpty}" Foreground="#FFC0392B"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static res:Strings.Hold_Reason}" Foreground="Gray" Margin="0,8,0,0" />
                <TextBox AutomationProperties.AutomationId="HoldReason" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                <CheckBox AutomationProperties.AutomationId="HoldCreateNcr" Content="{x:Static res:Strings.Hold_CreateNcr}" IsChecked="{Binding CreateNcr}" />

                <TextBlock Style="{StaticResource PageError}" Text="{Binding ErrorMessage}" AutomationProperties.AutomationId="HoldError" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource CollapsedWhenEmpty}" Text="{Binding ResultMessage}" AutomationProperties.AutomationId="HoldResult"
                           Foreground="#FF2E7D32" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button AutomationProperties.AutomationId="HoldConfirm" Content="{x:Static res:Strings.Hold_Hold}" Command="{Binding HoldCommand}"
                            Padding="16,4" Margin="0,0,8,0" Background="#FFFFEBEE" />
                    <Button AutomationProperties.AutomationId="HoldClose" Content="{x:Static res:Strings.Hold_Close}" Command="{Binding CloseCommand}" Padding="16,4" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
