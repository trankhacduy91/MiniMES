<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.Planning.WorkOrderCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = WorkOrderCreateViewModel. Form on the left, preview of what Release would freeze on the right. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.WorkOrderCreate_Title}" Style="{StaticResource PageTitle}" />
        <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="Error" Text="{Binding ErrorMessage}"
                   Style="{StaticResource PageError}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{x:Static res:Strings.WorkOrder_Item}" Style="{StaticResource FieldLabel}" />
                    <ComboBox AutomationProperties.AutomationId="Item" ItemsSource="{Binding ItemOptions}"
                              SelectedItem="{Binding Item}" DisplayMemberPath="Code" />
                    <TextBlock Text="{Binding FieldErrors[ItemId]}" Style="{StaticResource FieldError}" />

                    <TextBlock Text="{x:Static res:Strings.WorkOrder_PlannedQty}" Style="{StaticResource FieldLabel}" />
                    <TextBox AutomationProperties.AutomationId="PlannedQty" Padding="3"
                             Text="{Binding PlannedQtyText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding FieldErrors[PlannedQty]}" Style="{StaticResource FieldError}" />

                    <TextBlock Text="{x:Static res:Strings.WorkOrder_Line}" Style="{StaticResource FieldLabel}" />
                    <ComboBox AutomationProperties.AutomationId="Line" ItemsSource="{Binding LineOptions}"
                              SelectedItem="{Binding Line}" DisplayMemberPath="Code" />
                    <TextBlock Text="{Binding FieldErrors[LineId]}" Style="{StaticResource FieldError}" />

                    <TextBlock Text="{x:Static res:Strings.WorkOrder_PlannedStart}" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <DatePicker AutomationProperties.AutomationId="StartDate" SelectedDate="{Binding StartDate}" Width="140" />
                        <TextBox AutomationProperties.AutomationId="StartTime" Width="60" Margin="6,0,0,0" Padding="3"
                                 ToolTip="{x:Static res:Strings.WorkOrderCreate_TimeHint}"
                                 Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FieldErrors[PlannedStart]}" Style="{StaticResource FieldError}" />

                    <TextBlock Text="{x:Static res:Strings.WorkOrder_PlannedEnd}" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <DatePicker AutomationProperties.AutomationId="EndDate" SelectedDate="{Binding EndDate}" Width="140" />
                        <TextBox AutomationProperties.AutomationId="EndTime" Width="60" Margin="6,0,0,0" Padding="3"
                                 ToolTip="{x:Static res:Strings.WorkOrderCreate_TimeHint}"
                                 Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FieldErrors[PlannedEnd]}" Style="{StaticResource FieldError}" />
                    <TextBlock Text="{x:Static res:Strings.WorkOrderCreate_TimeHint}" Style="{StaticResource FieldHint}" />

                    <TextBlock Text="{x:Static res:Strings.WorkOrder_Priority}" Style="{StaticResource FieldLabel}" />
                    <ComboBox AutomationProperties.AutomationId="Priority" Width="60" HorizontalAlignment="Left"
                              ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding Priority}" />
                    <TextBlock Text="{Binding FieldErrors[Priority]}" Style="{StaticResource FieldError}" />

                    <CheckBox AutomationProperties.AutomationId="RequireFai" Content="{x:Static res:Strings.WorkOrder_RequireFai}"
                              IsChecked="{Binding RequireFai}" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button AutomationProperties.AutomationId="Preview" Content="{x:Static res:Strings.WorkOrderCreate_Preview}"
                                Command="{Binding PreviewCommand}" Style="{StaticResource ToolButton}" />
                        <Button AutomationProperties.AutomationId="Save" Content="{x:Static res:Strings.Common_Save}"
                                Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource ToolButton}" />
                        <Button AutomationProperties.AutomationId="Cancel" Content="{x:Static res:Strings.Common_Cancel}"
                                Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" AutomationProperties.AutomationId="PreviewInfo" Text="{Binding PreviewInfo}"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource CollapsedWhenEmpty}" />
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.WorkOrderCreate_Operations}" Style="{StaticResource FieldLabel}" />
                <DataGrid DockPanel.Dock="Top" AutomationProperties.AutomationId="PreviewOperations" ItemsSource="{Binding Operations}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_Seq}" Binding="{Binding Seq}" Width="45" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_Code}" Binding="{Binding OperationCode}" Width="80" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_WorkCenter}" Binding="{Binding WorkCenterCode}" Width="90" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_CycleTime}" Binding="{Binding IdealCycleTimeSec, StringFormat=0.###}" Width="70" />
                        <DataGridCheckBoxColumn Header="{x:Static res:Strings.Operation_Inspection}" Binding="{Binding IsInspection}" Width="75" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_Sop}" Binding="{Binding SopUrl}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.WorkOrderCreate_Materials}" Style="{StaticResource FieldLabel}" />
                <DataGrid AutomationProperties.AutomationId="PreviewMaterials" ItemsSource="{Binding Materials}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Seq}" Binding="{Binding OperationSeq}" Width="45" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Component}" Binding="{Binding ComponentCode}" Width="120" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Name}" Binding="{Binding ComponentName}" Width="*" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Uom}" Binding="{Binding Uom}" Width="45" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Required}" Binding="{Binding RequiredQty, StringFormat=0.#####}" Width="110" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_ToIssue}" Binding="{Binding RequiredQtyRounded, StringFormat=0.#####}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
