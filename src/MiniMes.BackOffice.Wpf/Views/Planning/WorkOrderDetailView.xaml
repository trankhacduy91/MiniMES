<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.Planning.WorkOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = WorkOrderDetailViewModel. Buttons are enabled from the server's allowedActions. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" AutomationProperties.AutomationId="Title" Text="{Binding Title}" Style="{StaticResource PageTitle}" />

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.WorkOrder_Line}" Foreground="Gray" Margin="0,0,8,2" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Detail.LineCode}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Static res:Strings.WorkOrderDetail_PlannedWindow}" Foreground="Gray" Margin="16,0,8,2" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PlannedWindow}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.WorkOrder_Priority}" Foreground="Gray" Margin="0,0,8,2" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Detail.Priority}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static res:Strings.WorkOrderDetail_Versions}" Foreground="Gray" Margin="16,0,8,2" />
            <TextBlock Grid.Row="1" Grid.Column="3" AutomationProperties.AutomationId="Versions" Text="{Binding Versions}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.WorkOrder_Fai}" Foreground="Gray" Margin="0,0,8,2" />
            <TextBlock Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="Fai" Text="{Binding Detail.FaiStatus}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Static res:Strings.WorkOrder_Progress}" Foreground="Gray" Margin="16,0,8,2" />
            <TextBlock Grid.Row="2" Grid.Column="3" AutomationProperties.AutomationId="Progress" Text="{Binding Progress}" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" AutomationProperties.AutomationId="Reason" Text="{Binding Reason}" Foreground="DarkOrange"
                   TextWrapping="Wrap" Margin="0,0,0,8" Style="{StaticResource CollapsedWhenEmpty}" />

        <!-- Status buttons -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button AutomationProperties.AutomationId="Release" Content="{x:Static res:Strings.WorkOrderDetail_Release}"
                    Command="{Binding ReleaseCommand}" Style="{StaticResource ToolButton}" />
            <Button AutomationProperties.AutomationId="Hold" Content="{x:Static res:Strings.WorkOrderDetail_Hold}"
                    Command="{Binding HoldCommand}" Style="{StaticResource ToolButton}" />
            <Button AutomationProperties.AutomationId="Resume" Content="{x:Static res:Strings.WorkOrderDetail_Resume}"
                    Command="{Binding ResumeCommand}" Style="{StaticResource ToolButton}" />
            <Button AutomationProperties.AutomationId="Complete" Content="{x:Static res:Strings.WorkOrderDetail_Complete}"
                    Command="{Binding CompleteCommand}" Style="{StaticResource ToolButton}" />
            <Button AutomationProperties.AutomationId="Close" Content="{x:Static res:Strings.WorkOrderDetail_Close}"
                    Command="{Binding CloseCommand}" Style="{StaticResource ToolButton}" />
            <Button AutomationProperties.AutomationId="CancelOrder" Content="{x:Static res:Strings.WorkOrderDetail_Cancel}"
                    Command="{Binding CancelCommand}" Style="{StaticResource ToolButton}" />
            <Separator Width="16" Visibility="Hidden" />
            <Button AutomationProperties.AutomationId="Refresh" Content="{x:Static res:Strings.Common_Refresh}"
                    Command="{Binding RefreshCommand}" Style="{StaticResource ToolButton}" />
            <Button AutomationProperties.AutomationId="Back" Content="{x:Static res:Strings.Common_Back}"
                    Command="{Binding BackCommand}" Style="{StaticResource ToolButton}" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="Error" Text="{Binding ErrorMessage}" Style="{StaticResource PageError}" />
        <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="Info" Text="{Binding InfoMessage}" Foreground="DarkGreen"
                   TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource CollapsedWhenEmpty}" />

        <TabControl>
            <TabItem AutomationProperties.AutomationId="TabOperations" Header="{x:Static res:Strings.WorkOrderDetail_TabOperations}">
                <DataGrid AutomationProperties.AutomationId="Operations" ItemsSource="{Binding Operations}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_Seq}" Binding="{Binding Seq}" Width="45" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_Code}" Binding="{Binding OperationCode}" Width="80" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_WorkCenter}" Binding="{Binding WorkCenterCode}" Width="90" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_CycleTime}" Binding="{Binding IdealCycleTimeSec, StringFormat=0.###}" Width="70" />
                        <DataGridCheckBoxColumn Header="{x:Static res:Strings.Operation_Inspection}" Binding="{Binding IsInspection}" Width="75" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_QtyGood}" Binding="{Binding QtyGood}" Width="60" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_QtyNg}" Binding="{Binding QtyNg}" Width="50" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Operation_Sop}" Binding="{Binding SopUrl}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="TabMaterials" Header="{x:Static res:Strings.WorkOrderDetail_TabMaterials}">
                <DataGrid AutomationProperties.AutomationId="Materials" ItemsSource="{Binding Materials}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Seq}" Binding="{Binding OperationSeq}" Width="45" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Component}" Binding="{Binding ComponentCode}" Width="120" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Name}" Binding="{Binding ComponentName}" Width="*" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Uom}" Binding="{Binding Uom}" Width="45" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Required}" Binding="{Binding RequiredQty, StringFormat=0.#####}" Width="110" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_ToIssue}" Binding="{Binding RequiredQtyRounded, StringFormat=0.#####}" Width="80" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Issued}" Binding="{Binding IssuedQty, StringFormat=0.#####}" Width="70" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Material_Consumed}" Binding="{Binding ConsumedQty, StringFormat=0.#####}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="TabSerials" Header="{x:Static res:Strings.WorkOrderDetail_TabSerials}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{x:Static res:Strings.Common_Previous}" Command="{Binding PreviousSerialsCommand}" Style="{StaticResource ToolButton}" />
                                <Button Content="{x:Static res:Strings.Common_Next}" Command="{Binding NextSerialsCommand}" Style="{StaticResource ToolButton}" />
                            </StackPanel>
                            <TextBlock AutomationProperties.AutomationId="SerialPageInfo" Text="{Binding SerialPageText}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid AutomationProperties.AutomationId="Serials" ItemsSource="{Binding Serials}" SelectedItem="{Binding SelectedSerial}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static res:Strings.Serial_SerialNo}" Binding="{Binding SerialNo}" Width="*" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Serial_Status}" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Serial_CurrentSeq}" Binding="{Binding CurrentSeq}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <!-- Labels: preview one, print all to a .zpl file, reprint the selected one with a reason -->
                    <StackPanel Grid.Column="1" Width="500" Margin="12,0,0,0">
                        <WrapPanel>
                            <Button AutomationProperties.AutomationId="PreviewLabel" Content="{x:Static res:Strings.WorkOrderDetail_PreviewLabel}"
                                    Command="{Binding PreviewLabelCommand}" Style="{StaticResource ToolButton}" />
                            <Button AutomationProperties.AutomationId="PrintLabels" Content="{x:Static res:Strings.WorkOrderDetail_PrintLabels}"
                                    Command="{Binding PrintLabelsCommand}" Style="{StaticResource ToolButton}" />
                            <Button AutomationProperties.AutomationId="Reprint" Content="{x:Static res:Strings.WorkOrderDetail_Reprint}"
                                    Command="{Binding ReprintSelectedCommand}" Style="{StaticResource ToolButton}" />
                        </WrapPanel>
                        <TextBlock Text="{x:Static res:Strings.WorkOrderDetail_LabelPreview}" Style="{StaticResource FieldHint}" Margin="0,6,0,4" />
                        <Border BorderBrush="#D0D5DD" BorderThickness="1" HorizontalAlignment="Left">
                            <Image AutomationProperties.AutomationId="LabelImage" Source="{Binding LabelImage, Converter={StaticResource BytesToImage}}"
                                   Width="480" Stretch="Uniform" />
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
