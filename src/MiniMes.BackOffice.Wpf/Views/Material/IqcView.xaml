<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.Material.IqcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = IqcViewModel ([v2] spec M6 step 2b). Deliveries waiting on top, the result form for the selected one,
         latest results below. -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="Refresh" Content="{x:Static res:Strings.Iqc_Refresh}"
                    Command="{Binding RefreshCommand}" Padding="10,2" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static res:Strings.Iqc_Title}" Style="{StaticResource PageTitle}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="Error" Text="{Binding ErrorMessage}"
                   Style="{StaticResource PageError}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static res:Strings.Iqc_Pending}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DataGrid Grid.Row="1" AutomationProperties.AutomationId="Pending" ItemsSource="{Binding Pending}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_Item}" Binding="{Binding Item.ItemCode}" Width="130" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_SupplierLot}" Binding="{Binding Item.SupplierLot}" Width="130" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_Reels}" Binding="{Binding Item.LotCount}" Width="60" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_TotalQty}" Binding="{Binding Item.TotalQty, StringFormat=N0}" Width="90" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_Received}" Binding="{Binding ReceivedText}" Width="130" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_Expiry}" Binding="{Binding ExpiryText}" Width="110" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Receiving_Item}" Binding="{Binding Item.ItemName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Result form: enabled once a delivery is selected (the buttons' CanExecute). -->
            <Border Grid.Row="2" Background="#F7F8FA" BorderBrush="#D0D5DD" BorderThickness="1" Padding="10" Margin="0,8">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Iqc_Hint}" Style="{StaticResource FieldHint}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="{x:Static res:Strings.Iqc_SampleQty}" Style="{StaticResource FieldLabel}" />
                            <TextBox AutomationProperties.AutomationId="SampleQty" Padding="3" Text="{Binding SampleQtyText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding FieldErrors[SampleQty]}" Style="{StaticResource FieldError}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="{x:Static res:Strings.Iqc_DefectQty}" Style="{StaticResource FieldLabel}" />
                            <TextBox AutomationProperties.AutomationId="DefectQty" Padding="3" Text="{Binding DefectQtyText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding FieldErrors[DefectQty]}" Style="{StaticResource FieldError}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock Text="{x:Static res:Strings.Iqc_DefectCode}" Style="{StaticResource FieldLabel}" />
                            <ComboBox AutomationProperties.AutomationId="DefectCode" ItemsSource="{Binding DefectCodes}" SelectedItem="{Binding DefectCode}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock><Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" /></TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding FieldErrors[DefectCode]}" Style="{StaticResource FieldError}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Width="260">
                            <TextBlock Text="{x:Static res:Strings.Iqc_Note}" Style="{StaticResource FieldLabel}" />
                            <TextBox AutomationProperties.AutomationId="Note" Padding="3" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding FieldErrors[Note]}" Style="{StaticResource FieldError}" TextWrapping="Wrap" />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button AutomationProperties.AutomationId="Pass" Content="{x:Static res:Strings.Iqc_Pass}" Command="{Binding PassCommand}"
                                Padding="18,4" Margin="0,0,8,0" Background="#FFE8F5E9" />
                        <Button AutomationProperties.AutomationId="Fail" Content="{x:Static res:Strings.Iqc_Fail}" Command="{Binding FailCommand}"
                                Padding="18,4" Background="#FFFFEBEE" />
                        <TextBlock AutomationProperties.AutomationId="IqcResult" Text="{Binding ResultMessage}" Foreground="#FF2E7D32"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Iqc_Records}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DataGrid Grid.Row="4" AutomationProperties.AutomationId="Records" ItemsSource="{Binding Records}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_InspectedAt}" Binding="{Binding InspectedText}" Width="130" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_Item}" Binding="{Binding Record.ItemCode}" Width="130" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_SupplierLot}" Binding="{Binding Record.SupplierLot}" Width="130" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_Result}" Binding="{Binding Record.Result}" Width="55" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_Reels}" Binding="{Binding Record.LotCount}" Width="50" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_SampleQty}" Binding="{Binding Record.SampleQty}" Width="70" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_DefectQty}" Binding="{Binding Record.DefectQty}" Width="70" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_DefectCode}" Binding="{Binding Record.DefectCode}" Width="120" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_InspectedBy}" Binding="{Binding Record.InspectedBy}" Width="70" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Iqc_Note}" Binding="{Binding Record.Note}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
