<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.Machines.LineDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = LineDashboardViewModel (spec M4 step 8). The ViewModel only knows states; colours live here.
         Running green, Idle light yellow, Down red, Setup blue, PlannedStop dark grey, Offline light grey. -->
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Width" Value="230" />
            <Setter Property="MinHeight" Value="150" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#FFEEEEEE" />
            <Setter Property="TextElement.Foreground" Value="#FF212121" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Background" Value="#FF2E7D32" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Idle">
                    <Setter Property="Background" Value="#FFFFF59D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Down">
                    <Setter Property="Background" Value="#FFC62828" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Setup">
                    <Setter Property="Background" Value="#FF1565C0" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="PlannedStop">
                    <Setter Property="Background" Value="#FF424242" />
                    <Setter Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Offline">
                    <Setter Property="Background" Value="#FFBDBDBD" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{x:Static res:Strings.Dashboard_Line}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox AutomationProperties.AutomationId="DashboardLine" Width="160" ItemsSource="{Binding Lines}"
                          SelectedItem="{Binding SelectedLine}" DisplayMemberPath="Code" />
            </StackPanel>
            <TextBlock Text="{x:Static res:Strings.Dashboard_Title}" FontSize="20" FontWeight="SemiBold" />
        </DockPanel>

        <!-- SignalR lost: what is on screen may be old until the reconnect reloads the snapshot. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Background="#FFFFA000"
                Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVisibility}}">
            <TextBlock AutomationProperties.AutomationId="ReconnectingBanner" Text="{x:Static res:Strings.Dashboard_Reconnecting}" FontWeight="SemiBold" />
        </Border>

        <!-- [v2] Escalation sent to this user's role. -->
        <Border DockPanel.Dock="Top" Background="#FFB71C1C">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Banner}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EscalationAlert}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Dashboard_Dismiss}" Command="{Binding DismissEscalationCommand}" Padding="10,2" />
                <TextBlock AutomationProperties.AutomationId="EscalationBanner" Text="{Binding EscalationAlert}" Foreground="White"
                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- [M4b] Edge gateway cards: online (outline) or OFFLINE (red, LWT), its outbox, how many PLCs it can read.
             A lost PLC = grey tile + "1/2 machines connected" here; a dead gateway = this card red. -->
        <ItemsControl DockPanel.Dock="Top" AutomationProperties.AutomationId="Gateways" ItemsSource="{Binding Gateways}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border AutomationProperties.AutomationId="{Binding Gateway}" Margin="0,0,10,0" Padding="10,6" CornerRadius="4" BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#FF2E7D32" />
                                <Setter Property="Background" Value="#FFF1F8E9" />
                                <Setter Property="TextElement.Foreground" Value="#FF212121" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="BorderBrush" Value="#FFC62828" />
                                        <Setter Property="Background" Value="#FFC62828" />
                                        <Setter Property="TextElement.Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DevicesText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding QueueText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DroppedText}" Margin="16,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="Error" Text="{Binding ErrorMessage}"
                   Style="{StaticResource PageError}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0" AutomationProperties.AutomationId="Tiles" ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tile}" AutomationProperties.AutomationId="{Binding Code}">
                            <StackPanel>
                                <DockPanel>
                                    <!-- [v2] where the data comes from: MQTT, or OPC UA / Modbus through the edge gateway -->
                                    <Border DockPanel.Dock="Right" Background="#33000000" CornerRadius="2" Padding="4,0">
                                        <TextBlock Text="{Binding SourceLabel}" FontSize="10" />
                                    </Border>
                                    <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="14" />
                                </DockPanel>
                                <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.85" />
                                <TextBlock Text="{Binding StateText}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding HourText}" FontSize="16" />
                                <TextBlock Text="{Binding CounterText}" FontSize="11" Opacity="0.85" />
                                <ItemsControl ItemsSource="{Binding Process}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Bad quality (sensor cut, out of range) stays visible but greyed. -->
                                            <TextBlock Text="{Binding Text}" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBad}" Value="True">
                                                                <Setter Property="Opacity" Value="0.45" />
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Dashboard_OpenAndons}" FontWeight="SemiBold" Margin="0,8,0,4" />

            <DataGrid Grid.Row="2" AutomationProperties.AutomationId="AndonGrid" ItemsSource="{Binding Andons}"
                      AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.RowStyle>
                    <!-- [v2] Level >= 1: nobody acknowledged in time. Opacity is animated, not the brush (a brush set by a
                         style is frozen and cannot be animated). -->
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEscalated}" Value="True">
                                <Setter Property="Background" Value="#FFEF5350" />
                                <Setter Property="Foreground" Value="White" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Blink">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45"
                                                             Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Blink" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:Strings.Dashboard_Machine}" Binding="{Binding Machine}" IsReadOnly="True" Width="110" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Dashboard_Type}" Binding="{Binding Type}" IsReadOnly="True" Width="75" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Dashboard_Status}" Binding="{Binding Status}" IsReadOnly="True" Width="100" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Dashboard_RaisedAt}" Binding="{Binding RaisedAt}" IsReadOnly="True" Width="70" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Dashboard_RaisedBy}" Binding="{Binding RaisedBy}" IsReadOnly="True" Width="80" />
                    <!-- Takes what is left: the grid fits its page, no horizontal scrolling that hides the Machine column. -->
                    <DataGridTextColumn Header="" Binding="{Binding AckText}" IsReadOnly="True" Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Dashboard_Level}" Binding="{Binding Level}" IsReadOnly="True" Width="45" />
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Dashboard_Reason}" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox AutomationProperties.AutomationId="AndonReason" DisplayMemberPath="Name"
                                          ItemsSource="{Binding DataContext.DowntimeReasons, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding SelectedReason, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.CanRespond, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding DataContext.CanRespond, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                    <Button AutomationProperties.AutomationId="AndonAcknowledge" Content="{x:Static res:Strings.Dashboard_Acknowledge}"
                                            Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="8,1" Margin="0,0,4,0"
                                            Visibility="{Binding IsRaised, Converter={StaticResource BoolToVisibility}}" />
                                    <Button AutomationProperties.AutomationId="AndonResolve" Content="{x:Static res:Strings.Dashboard_Resolve}"
                                            Command="{Binding DataContext.ResolveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="8,1" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
