<UserControl x:Class="MiniMes.BackOffice.Wpf.Views.Oee.OeeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = OeeDashboardViewModel (spec M5 step 8). Numbers come ready from the API; the charts are PlotModels
         built in the ViewModel (OxyPlot.Core), PlotView only draws them. -->
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Width" Value="190" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#FFF5F5F5" />
            <Setter Property="BorderBrush" Value="#FFDDDDDD" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <DataTemplate x:Key="CardTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#FF555555" />
                <TextBlock Text="{Binding Text}" FontSize="30" FontWeight="SemiBold" />
                <ProgressBar Value="{Binding Bar, Mode=OneWay}" Maximum="100" Height="8" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Filters: line, machine, current shift or a date + shift. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="{x:Static res:Strings.Oee_Line}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox AutomationProperties.AutomationId="OeeLine" Width="90" ItemsSource="{Binding Lines}"
                          SelectedItem="{Binding SelectedLine}" DisplayMemberPath="Code" Margin="0,0,10,0" />
                <TextBlock Text="{x:Static res:Strings.Oee_Machine}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox AutomationProperties.AutomationId="OeeMachine" Width="170" ItemsSource="{Binding Machines}"
                          SelectedItem="{Binding SelectedMachine}" DisplayMemberPath="Label" Margin="0,0,10,0" />
                <CheckBox AutomationProperties.AutomationId="OeeCurrentShift" Content="{x:Static res:Strings.Oee_CurrentShift}"
                          IsChecked="{Binding IsCurrentShift}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{x:Static res:Strings.Oee_Date}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <DatePicker AutomationProperties.AutomationId="OeeDate" Width="115" SelectedDate="{Binding SelectedDate}"
                            IsEnabled="{Binding IsCurrentShift, Converter={StaticResource Not}}" Margin="0,0,10,0" />
                <TextBlock Text="{x:Static res:Strings.Oee_Shift}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox AutomationProperties.AutomationId="OeeShift" Width="60" ItemsSource="{Binding Shifts}"
                          SelectedItem="{Binding SelectedShift}" IsEnabled="{Binding IsCurrentShift, Converter={StaticResource Not}}"
                          Margin="0,0,10,0" />
                <Button AutomationProperties.AutomationId="OeeRefresh" Content="{x:Static res:Strings.Oee_Refresh}"
                        Command="{Binding RefreshCommand}" Padding="10,2" Margin="0,0,6,0" />
                <Button AutomationProperties.AutomationId="OeeExport" Content="{x:Static res:Strings.Oee_ExportOee}"
                        Command="{Binding ExportOeeCommand}" Padding="10,2" Margin="0,0,6,0" />
                <Button AutomationProperties.AutomationId="ParetoExport" Content="{x:Static res:Strings.Oee_ExportPareto}"
                        Command="{Binding ExportParetoCommand}" Padding="10,2" />
            </WrapPanel>
            <TextBlock Text="{x:Static res:Strings.Oee_Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="#FFFFA000" Padding="10,6" Margin="0,0,0,8" CornerRadius="3"
                Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Static res:Strings.Dashboard_Reconnecting}" FontWeight="SemiBold" />
        </Border>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageError}" Text="{Binding ErrorMessage}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CollapsedWhenEmpty}" Text="{Binding ExportMessage}" Foreground="#FF2E7D32" />

        <!-- A / P / Q / OEE, the shift and its counts, warning badges (a data problem, not a good or bad result). -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="CardAvailability">
                    <ContentPresenter Content="{Binding Availability}" ContentTemplate="{StaticResource CardTemplate}" />
                </Border>
                <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="CardPerformance">
                    <ContentPresenter Content="{Binding Performance}" ContentTemplate="{StaticResource CardTemplate}" />
                </Border>
                <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="CardQuality">
                    <ContentPresenter Content="{Binding Quality}" ContentTemplate="{StaticResource CardTemplate}" />
                </Border>
                <Border Style="{StaticResource Card}" AutomationProperties.AutomationId="CardOee" Background="#FFE3F2FD">
                    <ContentPresenter Content="{Binding OeeCard}" ContentTemplate="{StaticResource CardTemplate}" />
                </Border>
            </StackPanel>
            <TextBlock AutomationProperties.AutomationId="OeeShiftText" Text="{Binding ShiftText}" Margin="0,6,0,0" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CountsText}" Foreground="#FF555555" />
            <ItemsControl ItemsSource="{Binding Warnings}" AutomationProperties.AutomationId="OeeWarnings">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Yellow with a sign, not colour alone. -->
                        <Border Background="#FFFFE082" BorderBrush="#FFF9A825" BorderThickness="1" CornerRadius="3"
                                Padding="8,3" Margin="0,4,0,0" HorizontalAlignment="Left">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="⚠ " /><Run Text="{Binding Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="140" />
            </Grid.RowDefinitions>

            <oxy:PlotView Grid.Column="0" AutomationProperties.AutomationId="HourlyChart"
                          Model="{Binding Hourly.PlotModel}" Controller="{Binding Hourly.Controller}" Margin="0,0,6,0" />
            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                <CheckBox DockPanel.Dock="Top" AutomationProperties.AutomationId="ParetoByCount" Content="{x:Static res:Strings.Oee_ByCount}"
                          IsChecked="{Binding ParetoByCount}" HorizontalAlignment="Right" />
                <oxy:PlotView AutomationProperties.AutomationId="ParetoChart"
                              Model="{Binding Pareto.PlotModel}" Controller="{Binding Pareto.Controller}" />
            </DockPanel>

            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static res:Strings.Oee_Unclassified}" FontWeight="SemiBold" Margin="0,8,0,4" />
            <DataGrid Grid.Row="2" Grid.ColumnSpan="2" AutomationProperties.AutomationId="UnclassifiedGrid" ItemsSource="{Binding Unclassified}"
                      AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static res:Strings.Dashboard_Machine}" Binding="{Binding Machine}" IsReadOnly="True" Width="120" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Oee_State}" Binding="{Binding State}" IsReadOnly="True" Width="70" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Oee_Period}" Binding="{Binding Period}" IsReadOnly="True" Width="95" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Oee_Minutes}" Binding="{Binding Minutes}" IsReadOnly="True" Width="65" />
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Oee_Reason}" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox AutomationProperties.AutomationId="UnclassifiedReason" DisplayMemberPath="Name"
                                          ItemsSource="{Binding DataContext.DowntimeReasons, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding SelectedReason, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.CanClassify, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Oee_Note}" Width="*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding DataContext.CanClassify, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.AutomationId="UnclassifiedSave" Content="{x:Static res:Strings.Oee_Save}"
                                        Command="{Binding DataContext.ClassifyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="8,1"
                                        Visibility="{Binding DataContext.CanClassify, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
