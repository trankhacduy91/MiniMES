<Window x:Class="MiniMes.BackOffice.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core"
        xmlns:vm="clr-namespace:MiniMes.Client.Core.ViewModels;assembly=MiniMes.Client.Core"
        xmlns:md="clr-namespace:MiniMes.Client.Core.ViewModels.MasterData;assembly=MiniMes.Client.Core"
        xmlns:views="clr-namespace:MiniMes.BackOffice.Wpf.Views"
        xmlns:mdviews="clr-namespace:MiniMes.BackOffice.Wpf.Views.MasterData"
        xmlns:pl="clr-namespace:MiniMes.Client.Core.ViewModels.Planning;assembly=MiniMes.Client.Core"
        xmlns:plviews="clr-namespace:MiniMes.BackOffice.Wpf.Views.Planning"
        xmlns:ex="clr-namespace:MiniMes.Client.Core.ViewModels.Execution;assembly=MiniMes.Client.Core"
        xmlns:exviews="clr-namespace:MiniMes.BackOffice.Wpf.Views.Execution"
        xmlns:mc="clr-namespace:MiniMes.Client.Core.ViewModels.Machines;assembly=MiniMes.Client.Core"
        xmlns:mcviews="clr-namespace:MiniMes.BackOffice.Wpf.Views.Machines"
        Title="{x:Static res:Strings.BackOffice_Title}"
        AutomationProperties.Name="{x:Static res:Strings.BackOffice_Title}"
        Width="1200" Height="760" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- ViewModel type -> View. Navigation swaps CurrentViewModel; WPF picks the matching template. -->
        <DataTemplate DataType="{x:Type vm:UserLoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type mc:LineDashboardViewModel}">
            <mcviews:LineDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackOfficeShellViewModel}">
            <views:ShellView />
        </DataTemplate>
        <!-- Pages shown inside the shell -->
        <DataTemplate DataType="{x:Type md:ItemListViewModel}">
            <mdviews:ItemListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type md:ItemEditViewModel}">
            <mdviews:ItemEditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type md:BomViewModel}">
            <mdviews:BomView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type md:RoutingEditorViewModel}">
            <mdviews:RoutingEditorView />
        </DataTemplate>
        <!-- One template for every catalog: WPF matches DataTemplates on base types too. -->
        <DataTemplate DataType="{x:Type md:CatalogViewModel}">
            <mdviews:CatalogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type md:ImportViewModel}">
            <mdviews:ImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ex:ExecutionReportViewModel}">
            <exviews:ExecutionReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pl:WorkOrderListViewModel}">
            <plviews:WorkOrderListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pl:WorkOrderCreateViewModel}">
            <plviews:WorkOrderCreateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pl:WorkOrderDetailViewModel}">
            <plviews:WorkOrderDetailView />
        </DataTemplate>
    </Window.Resources>

    <!-- DataContext = Navigation (set in App.xaml.cs) -->
    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
