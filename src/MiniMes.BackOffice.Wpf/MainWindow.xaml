<Window x:Class="MiniMes.BackOffice.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core"
        xmlns:vm="clr-namespace:MiniMes.Client.Core.ViewModels;assembly=MiniMes.Client.Core"
        xmlns:views="clr-namespace:MiniMes.BackOffice.Wpf.Views"
        Title="{x:Static res:Strings.BackOffice_Title}"
        AutomationProperties.Name="{x:Static res:Strings.BackOffice_Title}"
        Width="900" Height="600" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- ViewModel type -> View. Navigation swaps CurrentViewModel; WPF picks the matching template. -->
        <DataTemplate DataType="{x:Type vm:UserLoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
    </Window.Resources>

    <!-- DataContext = Navigation (set in App.xaml.cs) -->
    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
