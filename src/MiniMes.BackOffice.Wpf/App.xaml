<!-- No StartupUri: App.xaml.cs builds the Generic Host and shows MainWindow from the container
     (with StartupUri WPF would also open its own MainWindow -> two windows). -->
<Application x:Class="MiniMes.BackOffice.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MiniMes.BackOffice.Wpf">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="Not" />
        <local:BytesToImageConverter x:Key="BytesToImage" />

        <!-- Shared look of the master data pages -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <!-- The message under a box; bound to FieldErrors[Name] (client rule or server answer). -->
        <!-- Takes no space while empty, so forms stay compact until there is something to say. -->
        <Style x:Key="CollapsedWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource CollapsedWhenEmpty}">
            <Setter Property="Foreground" Value="Firebrick" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CollapsedWhenEmpty}">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PageError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Firebrick" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Application.Resources>
</Application>
