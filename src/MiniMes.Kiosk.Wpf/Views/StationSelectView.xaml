<UserControl x:Class="MiniMes.Kiosk.Wpf.Views.StationSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = StationSelectViewModel. The station is fixed (appsettings); the operator only picks the WO
         from the line's dispatch list, most urgent first and already selected: one tap on Start. Big rows for touch. -->
    <DockPanel Margin="32">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="Logout" Content="{x:Static res:Strings.Home_Logout}"
                    Command="{Binding LogoutCommand}" Padding="24,8" />
            <StackPanel>
                <TextBlock AutomationProperties.AutomationId="Station" Text="{Binding StationLabel}" Foreground="Gray" />
                <TextBlock AutomationProperties.AutomationId="Operator" Text="{Binding OperatorText}" Foreground="Gray" />
                <TextBlock Text="{x:Static res:Strings.StationSelect_Title}" FontSize="36" FontWeight="SemiBold" Margin="0,8,0,0" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="Start" Content="{x:Static res:Strings.StationSelect_Start}"
                    Command="{Binding StartCommand}" FontSize="32" Padding="64,16" />
            <Button DockPanel.Dock="Left" AutomationProperties.AutomationId="Refresh" Content="{x:Static res:Strings.StationSelect_Refresh}"
                    Command="{Binding RefreshCommand}" Padding="24,8" />
            <StackPanel VerticalAlignment="Center" Margin="16,0">
                <TextBlock AutomationProperties.AutomationId="Status" Text="{Binding StatusMessage}" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock AutomationProperties.AutomationId="Error" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <DataGrid AutomationProperties.AutomationId="DispatchGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  RowHeight="56" GridLinesVisibility="Horizontal">
            <DataGrid.Resources>
                <!-- Tall rows for touch: keep the text in the middle of the row, away from the grid line. -->
                <Style x:Key="Cell" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="8,0" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding StartCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:Strings.WorkOrder_Priority}" Binding="{Binding Wo.Priority}" Width="110" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="{x:Static res:Strings.WorkOrder_WoNo}" Binding="{Binding Wo.WoNo}" Width="220" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="{x:Static res:Strings.WorkOrder_Item}" Binding="{Binding Wo.ItemCode}" Width="*" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="{x:Static res:Strings.WorkOrder_Progress}" Binding="{Binding Progress}" Width="220" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="{x:Static res:Strings.WorkOrder_Status}" Binding="{Binding Wo.Status}" Width="160" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="{x:Static res:Strings.WorkOrder_Fai}" Binding="{Binding Fai}" Width="140" ElementStyle="{StaticResource Cell}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
