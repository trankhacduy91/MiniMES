<UserControl x:Class="MiniMes.Kiosk.Wpf.Views.RepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core"
             Foreground="White">
    <!-- DataContext = RepairViewModel (spec M3 step 8). Scan the NG board (check-in), then the repair form; Done sends
         it back to the line. While scanning, the focus stays in ScanBox like on the scan screen; while the form is
         open, the technician types (action, replaced part), so the focus is free. -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="#FF2B2B2B" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Ok">
                        <Setter Property="Background" Value="#FF1B8F3A" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Blocked">
                        <Setter Property="Background" Value="#FFC62828" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="32,32,32,16">
            <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="Logout" Content="{x:Static res:Strings.Home_Logout}"
                    Command="{Binding LogoutCommand}" Focusable="False" Padding="24,8" Margin="12,0,0,0" />
            <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="ChangeWorkOrder" Content="{x:Static res:Strings.Scan_ChangeWorkOrder}"
                    Command="{Binding ChangeWorkOrderCommand}" Focusable="False" Padding="24,8" />
            <StackPanel>
                <TextBlock AutomationProperties.AutomationId="Station" Text="{Binding StationCode}" FontSize="32" FontWeight="SemiBold" />
                <TextBlock AutomationProperties.AutomationId="WorkOrder" Text="{Binding WorkOrderText}" />
                <TextBlock AutomationProperties.AutomationId="Operator" Text="{Binding OperatorText}" Foreground="LightGray" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#FFB71C1C" Padding="16" Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
            <TextBlock AutomationProperties.AutomationId="OfflineBanner" Text="{x:Static res:Strings.Scan_Offline}"
                       FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" />
        </Border>

        <!-- Scan mode: the result of the last check-in or repair. -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0"
                    Visibility="{Binding IsScanMode, Converter={StaticResource BoolToVisibility}}">
            <TextBlock AutomationProperties.AutomationId="Headline" Text="{Binding Headline}"
                       FontSize="140" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock AutomationProperties.AutomationId="Message" Text="{Binding Message}"
                       FontSize="44" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock AutomationProperties.AutomationId="Detail" Text="{Binding Detail}"
                       FontSize="26" Foreground="#E0FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock Text="{x:Static res:Strings.Repair_ScanHint}" FontSize="24" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,24,0,0" />
        </StackPanel>

        <!-- Form mode: what was done to the checked-in board. -->
        <Border Grid.Row="2" Background="#FF383838" Margin="32,0,32,32" Padding="24" TextElement.FontSize="24"
                Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" AutomationProperties.AutomationId="Board"
                           Text="{Binding Board, StringFormat={x:Static res:Strings.Repair_Board}}" FontSize="36" FontWeight="Bold" />

                <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="Submit" Content="{x:Static res:Strings.Repair_Submit}"
                            Command="{Binding SubmitCommand}" FontSize="32" Padding="64,12" Margin="12,0,0,0" />
                    <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="CancelRepair" Content="{x:Static res:Strings.Repair_Cancel}"
                            Command="{Binding CancelRepairCommand}" Padding="32,12" />
                    <TextBlock AutomationProperties.AutomationId="FormError" Text="{Binding FormError}" Foreground="#FFFF8A80"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Repair_Defect}" Margin="0,0,0,8" />
                        <!-- One big tile per defect code: chosen by touch. -->
                        <ListBox AutomationProperties.AutomationId="RepairDefects" ItemsSource="{Binding DefectCodes}"
                                 SelectedItem="{Binding SelectedDefect}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <!-- The chosen tile must be obvious from a step away, also when the window is not active
                                 (the default selection colour is a faint grey then). -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="4" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Tile" Background="#FFEEEEEE" BorderBrush="#FFBDBDBD" BorderThickness="2">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="#FF1565C0" />
                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="#FF0D47A1" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="220" Margin="8" AutomationProperties.Name="{Binding Code}">
                                        <TextBlock Text="{Binding Code}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Name}" FontSize="18" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Static res:Strings.Repair_Action}" />
                        <TextBox x:Name="ActionBox" AutomationProperties.AutomationId="Action"
                                 Text="{Binding Action, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,8,0,16" />
                        <TextBlock Text="{x:Static res:Strings.Repair_Component}" />
                        <TextBox AutomationProperties.AutomationId="Component"
                                 Text="{Binding ComponentReplaced, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,8,0,16" />
                        <TextBlock Text="{x:Static res:Strings.Repair_Return}" />
                        <ComboBox AutomationProperties.AutomationId="ReturnTo" ItemsSource="{Binding ReturnOptions}"
                                  SelectedItem="{Binding SelectedReturn}" DisplayMemberPath="Text" Padding="8" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <TextBox Grid.Row="3" x:Name="ScanBox" AutomationProperties.AutomationId="ScanBox"
                 AutomationProperties.Name="{x:Static res:Strings.Scan_Input}"
                 Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsOffline}"
                 Visibility="{Binding IsScanMode, Converter={StaticResource BoolToVisibility}}"
                 FontSize="36" Padding="12" Margin="32,0,32,32" HorizontalContentAlignment="Center">
            <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding ScanCommand}" />
            </TextBox.InputBindings>
        </TextBox>
    </Grid>
</UserControl>
