<UserControl x:Class="MiniMes.Kiosk.Wpf.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:MiniMes.Client.Core.Resources;assembly=MiniMes.Client.Core">
    <!-- DataContext = HomeViewModel. Placeholder; M3 puts the scan screen here. -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock AutomationProperties.AutomationId="Station"
                   Text="{Binding StationCode, StringFormat={x:Static res:Strings.Kiosk_Station}}"
                   Foreground="Gray" Margin="0,0,0,8" />
        <TextBlock AutomationProperties.AutomationId="Welcome" Text="{Binding WelcomeText}"
                   FontSize="40" Margin="0,0,0,24" />
        <Button AutomationProperties.AutomationId="Logout" Content="{x:Static res:Strings.Home_Logout}"
                Command="{Binding LogoutCommand}" HorizontalAlignment="Left" Padding="16,8" />
    </StackPanel>
</UserControl>
