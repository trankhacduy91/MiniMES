{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Sop": {
    "RootPath": "../../docs/sop"
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883
  },
  "Andon": {
    "AutoRaiseAfterSeconds": 60
  },
  "Oee": {
    "MicroStopThresholdSec": 60,
    "SnapshotGraceMinutes": 5,
    "CatchUpDays": 2,
    "SnapshotJobEnabled": true
  },
  "Spc": {
    "RunLength": 7,
    "EnableWe3": false,
    "SamplerEnabled": true,
    "SamplerTickSec": 10,
    "GapPeriods": 3
  },
  "Material": {
    "EnforceLoadedMaterial": true
  },
  "Plant": {
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "AllowedHosts": "*"
}
